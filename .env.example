# Local default: SQLite. Production example:
# DATABASE_URL=mysql+pymysql://keli:change-me@mysql:3306/keli?charset=utf8mb4
DATABASE_URL=sqlite:///./data/keli.db

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

TENCENT_MAP_KEY=
MAP_RADIUS_METERS=3000
POI_LIMIT_PER_CATEGORY=12

# Required in public deployments for /api/admin/* write endpoints.
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_ENV=development
